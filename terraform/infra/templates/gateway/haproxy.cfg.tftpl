# Replaces a paid load balancer. Only used by kubectl (over the VPN) and by
# nodes joining; joined RKE2 agents load-balance across masters themselves.
# Bound to the private IP only, never the public one.
global
  maxconn 4096

defaults
  mode tcp
  timeout connect 5s
  # Long-lived kubectl watch / logs -f / exec streams.
  timeout client 1h
  timeout server 1h
%{ for port in [6443, 9345] ~}

frontend control_plane_${port}
  bind ${gateway_ip}:${port}
  default_backend masters_${port}

backend masters_${port}
  # HTTPS health check instead of a bare TCP connect, so a master whose port is
  # open but whose server hangs is taken out. The apiserver has anonymous auth
  # off, so its /readyz answers 401; the supervisor's /ping needs no auth.
  option httpchk GET ${port == 6443 ? "/readyz" : "/ping"}
  http-check expect ${port == 6443 ? "rstatus ^(200|401)$" : "status 200"}
  default-server check check-ssl verify none inter 5s fall 2 rise 2
%{ for i, ip in master_ips ~}
  server master-${i + 1} ${ip}:${port}
%{ endfor ~}
%{ endfor ~}
