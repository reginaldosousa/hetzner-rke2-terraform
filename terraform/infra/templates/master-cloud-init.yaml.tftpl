#cloud-config
# RKE2 server (control-plane + etcd) on a private-only server.
write_files:
  - path: /usr/local/bin/private-network.sh
    permissions: "0755"
    content: |
      ${indent(6, private_network_script)}

  - path: /etc/rancher/rke2/config.yaml
    permissions: "0600"
    content: |
      token: ${token}
      # Separate, join-only secret for workers (their userData is readable via
      # the metadata service, so they never get the server token).
      agent-token: ${agent_token}
%{ if !bootstrap ~}
      server: https://${control_plane_ip}:9345
%{ endif ~}
      node-ip: ${node_ip}
      advertise-address: ${node_ip}
      tls-san:
        - ${control_plane_ip}
      # The hcloud CCM sets providerID hcloud://<id>, which Karpenter needs.
      # Both are required: the first only configures the kubelet; without the
      # second RKE2 runs its own CCM and sets an immutable rke2:// providerID.
      cloud-provider-name: external
      disable-cloud-controller: true
      # Keep regular workloads on Karpenter-managed workers.
      node-taint:
        - "CriticalAddonsOnly=true:NoExecute"
%{ for path, content in files ~}

  - path: ${path}
    permissions: "0600"
    content: |
      ${indent(6, content)}
%{ endfor ~}

  # RKE2 auto-applies everything in this directory.
  - path: /var/lib/rancher/rke2/server/manifests/hcloud.yaml
    permissions: "0600"
    content: |
      # The "hcloud" Secret (token + network) is created by terraform/cluster,
      # so the API token never lands in instance metadata. The CCM waits for it.
      apiVersion: helm.cattle.io/v1
      kind: HelmChart
      metadata:
        name: hcloud-cloud-controller-manager
        namespace: kube-system
      spec:
        repo: https://charts.hetzner.cloud
        chart: hcloud-cloud-controller-manager
        version: "${ccm_version}"
        targetNamespace: kube-system
        # Must run before nodes are initialised (they carry the uninitialized taint).
        bootstrap: true
        valuesContent: |-
          networking:
            enabled: true
          env:
            # Pod traffic uses the canal overlay; no hcloud routes needed.
            HCLOUD_NETWORK_ROUTES_ENABLED:
              value: "false"
            # Karpenter sets topology.kubernetes.io/zone to the location (nbg1).
            HCLOUD_INSTANCES_ZONE_LABEL_ENABLED:
              value: "false"
            HCLOUD_LOAD_BALANCERS_LOCATION:
              value: "${location}"
            HCLOUD_LOAD_BALANCERS_USE_PRIVATE_IP:
              value: "true"
      ---
      apiVersion: helm.cattle.io/v1
      kind: HelmChart
      metadata:
        name: hcloud-csi
        namespace: kube-system
      spec:
        repo: https://charts.hetzner.cloud
        chart: hcloud-csi
        version: "${csi_version}"
        targetNamespace: kube-system

runcmd:
  - /usr/local/bin/private-network.sh
  - curl -sfL -o /root/rke2-install.sh "${rke2_install_url}" && echo "${rke2_install_sha256}  /root/rke2-install.sh" | sha256sum -c - && INSTALL_RKE2_VERSION="${rke2_version}" INSTALL_RKE2_TYPE=server sh /root/rke2-install.sh
  - systemctl enable --now rke2-server.service
