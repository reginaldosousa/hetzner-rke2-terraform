#cloud-config
# VPN entry point + NAT gateway + control-plane endpoint for the private network.
package_update: true
packages:
  - wireguard
  - nftables
  - haproxy

write_files:
  - path: /etc/sysctl.d/99-forwarding.conf
    content: |
      net.ipv4.ip_forward = 1
      # HAProxy binds the private IP, which DHCP may assign after it starts.
      net.ipv4.ip_nonlocal_bind = 1

  # Replaces a paid load balancer. Only used by kubectl (over the VPN) and by
  # nodes joining; joined RKE2 agents load-balance across masters themselves.
  # Bound to the private IP only, never the public one.
  - path: /etc/haproxy/haproxy.cfg
    content: |
      global
        maxconn 4096

      defaults
        mode tcp
        timeout connect 5s
        # Long-lived kubectl watch / logs -f / exec streams.
        timeout client 1h
        timeout server 1h
%{ for port in [6443, 9345] ~}

      frontend control_plane_${port}
        bind ${gateway_ip}:${port}
        default_backend masters_${port}

      backend masters_${port}
        default-server check inter 5s fall 2 rise 2
%{ for i, ip in master_ips ~}
        server master-${i + 1} ${ip}:${port}
%{ endfor ~}
%{ endfor ~}

  - path: /etc/wireguard/wg0.conf
    permissions: "0600"
    content: |
      [Interface]
      Address    = ${vpn_gateway_ip}/${vpn_prefix}
      ListenPort = ${vpn_port}
      PrivateKey = ${private_key}
%{ for peer in peers ~}

      # ${peer.name}
      [Peer]
      PublicKey  = ${peer.public_key}
      AllowedIPs = ${peer.ip}/32
%{ endfor ~}

  # Masquerade traffic leaving the private network for the internet.
  # VPN <-> network traffic is routed (not NATed); see hcloud_network_route.vpn_clients.
  - path: /etc/nftables.conf
    content: |
      #!/usr/sbin/nft -f
      flush ruleset

      table inet filter {
        chain forward {
          type filter hook forward priority 0; policy drop;
          ct state established,related accept
          ip saddr ${network_cidr} accept
          iifname "wg0" ip daddr ${network_cidr} accept
        }
      }

      table ip nat {
        chain postrouting {
          type nat hook postrouting priority 100;
          ip saddr ${network_cidr} ip daddr != { ${network_cidr}, ${vpn_cidr} } masquerade
        }
      }

runcmd:
  - sysctl --system
  - systemctl enable --now nftables
  - systemctl enable --now wg-quick@wg0
  - systemctl enable haproxy && systemctl restart haproxy
