#cloud-config
# VPN entry point + NAT gateway + control-plane endpoint for the private network.
# First boot only: later config changes are pushed by scripts/sync-gateway.sh
# (the server ignores user_data changes, so it is not rebuilt for them).
package_update: true
packages:
  - wireguard
  - nftables
  - haproxy

write_files:
  - path: /etc/sysctl.d/99-forwarding.conf
    content: |
      net.ipv4.ip_forward = 1
      # HAProxy binds the private IP, which DHCP may assign after it starts.
      net.ipv4.ip_nonlocal_bind = 1
%{ for path, content in files ~}

  - path: ${path}
    permissions: "0600"
    content: |
      ${indent(6, content)}
%{ endfor ~}

runcmd:
  - sysctl --system
  - systemctl enable --now nftables
  - systemctl enable --now wg-quick@wg0
  - systemctl enable haproxy && systemctl restart haproxy
